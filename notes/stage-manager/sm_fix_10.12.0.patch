+    private struct BBox { var minX: Int; var minY: Int; var maxX: Int; var maxY: Int }
+
+    private static func opaqueBBox(_ pixelBuffer: CVPixelBuffer) -> BBox {
+        let empty = BBox(minX: -1, minY: -1, maxX: -1, maxY: -1)
+        guard CVPixelBufferGetPixelFormatType(pixelBuffer) == kCVPixelFormatType_32BGRA,
+              CVPixelBufferLockBaseAddress(pixelBuffer, .readOnly) == kCVReturnSuccess,
+              let base = CVPixelBufferGetBaseAddress(pixelBuffer) else { return empty }
+        defer { CVPixelBufferUnlockBaseAddress(pixelBuffer, .readOnly) }
+        let width = CVPixelBufferGetWidth(pixelBuffer)
+        let height = CVPixelBufferGetHeight(pixelBuffer)
+        let bytesPerRow = CVPixelBufferGetBytesPerRow(pixelBuffer)
+        guard width >= 16, height >= 16 else { return empty }
+        let ptr = base.assumingMemoryBound(to: UInt8.self)
+        let grid = 32
+        var minX = grid, maxX = -1, minY = grid, maxY = -1
+        for sy in 0..<grid {
+            let py = (sy * height) / grid
+            let rowStart = py * bytesPerRow
+            for sx in 0..<grid {
+                let px = (sx * width) / grid
+                if ptr[rowStart + px * 4 + 3] > 16 {
+                    if sx < minX { minX = sx }
+                    if sx > maxX { maxX = sx }
+                    if sy < minY { minY = sy }
+                    if sy > maxY { maxY = sy }
+                }
+            }
+        }
+        return BBox(minX: minX, minY: minY, maxX: maxX, maxY: maxY)
+    }
+
+    private static func isSmallBBox(_ b: BBox) -> Bool {
+        guard b.maxX >= 0, b.maxY >= 0 else { return false }
+        let grid = 32
+        let w = b.maxX - b.minX + 1
+        let h = b.maxY - b.minY + 1
+        return w * 100 / grid < 55 && h * 100 / grid < 55
+    }
+
+    private static func layerContents(_ pixelBuffer: CVPixelBuffer, _ stageManagerEnabled: Bool) -> CALayerContents? {
+        let fullyTransparent = pixelBuffer.isFullyTransparent()
+        if stageManagerEnabled && (fullyTransparent || isSmallBBox(opaqueBBox(pixelBuffer))) {
+            return nil
+        }
+        return fullyTransparent ? .transparentPixelBuffer(pixelBuffer) : .pixelBuffer(pixelBuffer)
+    }
+
+    private static func isStageManagerEnabled() -> Bool {
+        let domain = "com.apple.WindowManager" as CFString
+        CFPreferencesAppSynchronize(domain)
+        guard let value = CFPreferencesCopyAppValue("GloballyEnabled" as CFString, domain) else { return false }
+        if let enabled = value as? Bool { return enabled }
+        if let enabled = value as? Int { return enabled != 0 }
+        return false
+    }
